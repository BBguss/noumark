{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noumark",
  "version": "0.1.0",
  "identifier": "com.kroombox.noumark",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Noumark",
        "width": 1180,
        "height": 800,
        "minWidth": 520,
        "minHeight": 360,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: http: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Bbguss",
    "copyright": "Copyright (c) 2026 Bbguss. MIT License.",
    "homepage": "https://github.com/BBguss/noumark",
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Fast, beautiful Markdown reader & editor",
    "longDescription": "Noumark opens Markdown files instantly with beautiful typography, themes, live reload, a formatting toolbar for in-place editing and a command palette.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
